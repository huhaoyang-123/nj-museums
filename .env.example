# 高德地图 API 配置
# 注意：Web端Key和Web服务端Key是两种不同类型，需分别在高德开发者平台申请

# Web服务端Key - 用于后端地理编码API（如 scripts/update_museum_coordinates.py）
AMAP_KEY=your_amap_web_service_key_here

# Web端Key - 用于前端地图渲染（通过 /api/amap-config 动态获取）
AMAP_WEB_KEY=your_amap_web_key_here

# Web端安全密钥（可选，用于某些高级功能）
AMAP_WEB_SECRET_KEY=your_amap_web_secret_key_here

# 服务器配置
PORT=5000

# AI服务配置
GROQ_API_KEY=sk-your-deepseek-api-key-here

# 百度语音识别配置
BAIDU_ASR_API_KEY=your_baidu_asr_api_key_here
BAIDU_ASR_SECRET_KEY=your_baidu_asr_secret_key_here
